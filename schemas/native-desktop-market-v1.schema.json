{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GreenLv/dsh-completion-guard/schemas/native-desktop-market-v1.schema.json",
  "title": "Desktop real-market coexistence acceptance (zero-model supplement to dsh-desktop-bound/v2)",
  "type": "object",
  "required": [
    "schema",
    "status",
    "product",
    "gate_profile",
    "repository",
    "runtime_tree_sha256",
    "artifact",
    "platform",
    "gates",
    "cleanup",
    "run",
    "unperformed_actions",
    "capability_skips",
    "host_lock_policy",
    "host_driver_sha256",
    "host_lock_digests",
    "desktop_runtime",
    "market",
    "market_coexistence_contract"
  ],
  "properties": {
    "schema": {
      "const": "native-acceptance/v2"
    },
    "status": {
      "const": "passed"
    },
    "product": {
      "const": "dsh_completion_guard"
    },
    "gate_profile": {
      "const": "desktop-market-coexistence/v1"
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "runtime_tree_sha256": {
      "type": "null"
    },
    "artifact": {
      "type": "object",
      "required": [
        "filename",
        "sha256",
        "size_bytes",
        "file_count",
        "git_head"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "git_head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "shell",
        "toolchain"
      ],
      "properties": {
        "os": {
          "enum": [
            "macos",
            "windows"
          ]
        },
        "shell": {
          "const": "python-subprocess"
        },
        "toolchain": {
          "type": "object"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "type": "object",
        "required": [
          "id",
          "required",
          "status",
          "subject",
          "exit_code",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "desktop_market_cleanup",
              "desktop_market_coexistence_lock",
              "desktop_market_final_coexistence",
              "desktop_market_graceful_stop",
              "desktop_market_guard_install",
              "desktop_market_guard_lock",
              "desktop_market_install",
              "desktop_market_loaded_backend",
              "desktop_market_lock_drift",
              "desktop_market_preinstall_graph",
              "desktop_market_probe_composition",
              "desktop_market_registry_identity",
              "desktop_market_remove_restore",
              "desktop_market_uninstall",
              "desktop_market_v070_explicit_release_minimum",
              "desktop_market_v070_future_vs_current_stop",
              "desktop_market_v070_goal_adoption_current_closure",
              "desktop_market_v070_history_compaction_restart",
              "desktop_market_v070_legacy_migration",
              "desktop_market_v070_ordinary_file_edit_readback",
              "desktop_market_v070_ordinary_test_and_checkpoint",
              "desktop_market_v070_root_v6_delivery",
              "desktop_market_v070_short_resume_and_persistence",
              "installed_syntax",
              "isolated_install",
              "manifest_identity",
              "package_inventory",
              "package_parity",
              "strict_second_noop"
            ]
          },
          "required": {
            "const": true
          },
          "status": {
            "const": "passed"
          },
          "exit_code": {
            "const": 0
          },
          "subject": {
            "type": "object"
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "required": [
        "status",
        "remaining_ids"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "remaining_ids": {
          "const": []
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "started_at",
        "finished_at"
      ]
    },
    "unperformed_actions": {
      "type": "array",
      "uniqueItems": true
    },
    "capability_skips": {
      "const": [
        "real_model_request",
        "graphical_shell",
        "market_gui"
      ]
    },
    "host_lock_policy": {
      "const": "dsh-core/v1"
    },
    "host_driver_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_lock_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desktop_pre_market",
        "desktop_coexistence",
        "desktop_final"
      ],
      "properties": {
        "desktop_pre_market": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "desktop_coexistence": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "desktop_final": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "desktop_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "header_sha256",
        "metadata_sha256",
        "host_version",
        "desktop_version",
        "payload_file_count"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "header_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host_version": {
          "type": "string"
        },
        "desktop_version": {
          "type": "string"
        },
        "payload_file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "registry_integrity"
      ],
      "properties": {
        "package": {
          "const": "dshmarket"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "registry_integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "market_coexistence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "market_install_entry",
        "lock_drift",
        "final_state"
      ],
      "properties": {
        "schema": {
          "const": "dsh-desktop-market-coexistence/v1"
        },
        "market_install_entry": {
          "const": "official_plugin_cli_registry_spec"
        },
        "lock_drift": {
          "const": "old_dump_verify_fails_after_market_change"
        },
        "final_state": {
          "const": "market_installed_with_rebound_lock"
        }
      }
    }
  }
}
