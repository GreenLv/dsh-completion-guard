{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GreenLv/dsh-completion-guard/schemas/native-host-probe-v2.schema.json",
  "title": "DSH Completion Guard 0.7 native host probe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nonce", "pid", "mode", "driver_sha256", "status", "cases", "real_model_request"],
  "properties": {
    "schema": { "const": "dsh-native-host-probe/v2" },
    "nonce": { "type": "string", "minLength": 1 },
    "pid": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["initial", "restart"] },
    "driver_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "real_model_request": { "const": false },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "positive", "negative"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?:v070_[a-z0-9_]+|v090_activation_birth_restore_adoption|initialize_runtime)$" },
          "status": { "enum": ["passed", "failed"] },
          "positive": { "type": "boolean" },
          "negative": { "type": "boolean" },
          "activation_assertion": { "enum": ["birth_source", "birth_t0", "birth_bound", "birth_mode", "restore_source", "restore_t0", "restore_prefix", "restore_identity", "restore_binding", "restore_mode", "deleted_binding_unknown", "deleted_binding_absent", "old_inventory", "old_adopt", "old_noop", "old_binding", "old_source", "old_t0", "old_identity", "old_mode", "old_create", "old_flush", "old_close", "old_inventory_read", "old_resume", "corpus_read"] },
          "operation": { "type": "string" },
          "error_code": { "type": "string" },
          "last_tool": { "type": ["object", "null"] },
          "precondition": {"enum": ["guard_tools_registered", "guard_boundary_active", "goal_protection_adopted"]},
          "terminal_assertion": {
            "type": "object", "additionalProperties": false, "required": ["expected", "actual"],
            "properties": {
              "expected": { "$ref": "#/$defs/terminal" },
              "actual": { "$ref": "#/$defs/terminal" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "exit_code", "timed_out", "aborted"],
      "properties": {
        "kind": { "enum": ["foreground", "background", null] },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": ["boolean", "null"] },
        "aborted": { "type": ["boolean", "null"] }
      }
    }
  }
}
